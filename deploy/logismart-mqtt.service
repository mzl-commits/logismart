[Unit]
Description=LogiSmart MQTT telemetry listener
After=network.target mosquitto.service postgresql.service redis-server.service
Requires=mosquitto.service postgresql.service redis-server.service

[Service]
Type=simple
User=yuri
Group=yuri
WorkingDirectory=/home/yuri/proyecto_logistica
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/yuri/proyecto_logistica/venv/bin/python manage.py mqtt_listener
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
